# Porta (Railway/Render definem PORT automaticamente)
PORT=8080

# Postgres (Supabase pooler — use a connection string JDBC)
DATABASE_URL=jdbc:postgresql://HOST:6543/postgres?prepareThreshold=0
DATABASE_USERNAME=postgres.PROJECT_REF
DATABASE_PASSWORD=sua_senha

# JWT do app
JWT_SECRET=uma-chave-longa-com-pelo-menos-256-bits

# API de futebol (api-sports.io)
FOOTBALL_API_KEY=sua_chave

# Supabase Auth
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sua_anon_key
SUPABASE_JWT_SECRET=seu_jwt_secret

# CORS — inclua seu domínio Vercel se usar URL customizada
# CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,https://*.vercel.app,https://seu-app.vercel.app